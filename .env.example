# Backend
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/discvault
ENCRYPTION_SECRET=your-32-byte-base64-encryption-key
TAVILY_API_KEY=tvly-xxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxx
OPENAI_API_KEY=sk-xxxxx
LLM_MODEL=claude-haiku-5-5
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Google OIDC. The shelf and the API are different origins, so the browser
# keeps a bearer token instead of a shared cookie.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=replace-with-a-long-random-string
FRONTEND_PUBLIC_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:8000
# true on Railway (https). false for local http.
SESSION_COOKIE_SECURE=false

# Frontend. Next inlines this at build time.
NEXT_PUBLIC_API_URL=http://localhost:8000
